# ---------------------------------------------------------------------------
# TOUT est optionnel : `docker compose up -d` fonctionne sans ce fichier.
# Copiez-le en `.env` uniquement pour changer les valeurs par defaut :
#     cp .env.example .env
# ---------------------------------------------------------------------------

# Port ouvert sur la machine hote (l'appli ecoute toujours sur 3333 dans le conteneur).
PORT=3333

# Identifiants de la base PostgreSQL embarquee.
# ATTENTION : ils ne sont pris en compte qu'a la creation du volume. Pour les changer
# apres coup : docker compose down -v  (ceci EFFACE la base).
POSTGRESQL_DATABASE=filetransfer
POSTGRESQL_USER=filetransfer
POSTGRESQL_PASSWORD=changez-moi

# Adresse publique du service. Sert a afficher la bonne URL au demarrage, et
# surtout d'ancrage aux passkeys : WebAuthn lie chaque cle a ce nom d'hote exact.
# En production, mettez l'adresse reellement visitee, en HTTPS.
PUBLIC_URL=http://localhost:3333

# Cle de chiffrement du stockage : 64 caracteres hexadecimaux (32 octets).
# Si elle est vide, une cle est generee au premier demarrage et rangee dans
# FILES_PATH/.storage-key. Cela fonctionne, mais la cle se trouve alors a cote
# des donnees qu'elle protege : une sauvegarde du dossier emporte les deux.
# Pour une protection reelle, reportez ici la cle affichee au demarrage et
# supprimez le fichier. Generer une cle :  openssl rand -hex 32
STORAGE_KEY=

# Plafond de stockage affiche dans le dashboard (500G, 2T, 1500M...).
# Laisser vide pour utiliser la capacite reelle du disque.
STORAGE_MAX=

# Duree de conservation du journal d'audit, en jours (0 = ne jamais purger).
AUDIT_RETENTION_DAYS=90

TZ=Europe/Paris

# ---------------------------------------------------------------------------
# Uniquement pour un lancement SANS Docker (`go run .`) :
# ---------------------------------------------------------------------------
# POSTGRESQL_HOST=localhost
# POSTGRESQL_PORT=5432
# FILES_PATH=files
